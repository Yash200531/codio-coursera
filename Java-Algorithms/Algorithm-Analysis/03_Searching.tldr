							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "a fundamental operation in cs. finding if a particular value exists within the array provided. "
								}
							]
						}
					]
				}
			},
			"parentId": "shape:XBpkhTZmC9eaYbcKcfQYC",
