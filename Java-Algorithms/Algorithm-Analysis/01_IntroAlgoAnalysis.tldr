								{
									"type": "text",
									"marks": [
										{
											"type": "bold"
										}
									],
									"text": "Time Complexity: "
								},
								{
									"type": "text",
									"text": "The total count of operations an algorithm will perform in its lifetime."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "As the size of input increases, runnning time of algo grows."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "We expreess time complexity as a function of input size ("
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "bold"
										},
										{
											"type": "italic"
										}
									],
									"text": "n"
								},
								{
									"type": "text",
									"text": ") often using "
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "highlight"
										}
									],
									"text": "Big O notation"
								}
							]
						}
					]
				}
			},
