							"content": [
								{
									"type": "text",
									"text": "To delete an element from an array, we don’t have a direct method. Instead, we’ll typically create a new array with a size smaller than the original array by one, and then copy all elements excluding the one to be deleted from the old array to the new one."
								}
							]
						}
					]
				}
			},
